g=global/switch views/lighttable
e=views/lighttable/preview;toggle
c=views/lighttable/toggle culling mode;toggle
n=views/lighttable/toggle culling dynamic mode
r=iop/crop
q=iop/retouch
w;shift=lib/masks
x=views/thumbtable/rating;reject
6=views/thumbtable/color label;red
7=views/thumbtable/color label;yellow
8=views/thumbtable/color label;green
9=views/thumbtable/color label;blue
j=views/darkroom/overexposed/toggle
z=views/darkroom/zoom close-up
f=views/darkroom/full preview
backslash=lib/snapshots/toggle last snapshot
apostrophe;ctrl=views/thumbtable/duplicate image
e;shift;ctrl=lib/export/start export
i;shift;ctrl=lib/import/add to library...
r;shift;ctrl=lib/copy_history/discard history
